{
  "name": "project-second-chance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Project Second Chance - local fictional-data foundation with an optional Mira connection test",
  "scripts": {
    "test": "vitest run",
    "test:api": "vitest run apps/server",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "test:secrets": "node --test scripts/verify-secrets.test.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@nuancelabs/js-sdk": "0.40.0",
    "better-sqlite3": "13.2.0",
    "cookie-parser": "1.4.7",
    "csrf-sync": "4.2.1",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "8.7.5",
    "express-session": "1.19.0",
    "file-type": "22.3.0",
    "image-size": "2.1.0",
    "multer": "2.5.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.2",
    "@types/multer": "2.3.0",
    "@types/node": "22.10.2",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "jsdom": "25.0.1",
    "supertest": "^7.1.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=22.2.0"
  }
}
